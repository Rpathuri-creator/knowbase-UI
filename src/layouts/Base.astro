---
import '../styles/global.css';
import { loadNotes, noteUrl } from '../lib/knowledge';

interface Props { title: string; active?: 'home' | 'graph' | 'review' | 'note'; currentSlug?: string; showSidebar?: boolean }
const { title, active, currentSlug, showSidebar = false } = Astro.props;
const notes = loadNotes();
const lessons = notes.filter((n) => n.status === 'lesson');
const stubs = notes.filter((n) => n.status === 'stub');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · System design garden</title>
  <meta name="theme-color" content="#faf6ee" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1c1a17" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    try { const t = localStorage.getItem('garden-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body data-base={base}>
  <header class="site-header">
    {showSidebar && (
      <button class="icon-btn menu-btn" id="menu-btn" aria-label="Show topics">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    )}
    <a class="brand" href={base}><span class="brand-mark">◆</span><span class="brand-text">System design garden</span></a>
    <nav class="nav">
      <a href={base} aria-current={active === 'home' ? 'page' : undefined}>Today</a>
      <a href={`${base}graph/`} aria-current={active === 'graph' ? 'page' : undefined}>Graph</a>
      <a href={`${base}review/`} aria-current={active === 'review' ? 'page' : undefined}>Review</a>
    </nav>
    <div class="header-actions">
      <button class="icon-btn" id="theme-btn" aria-label="Toggle dark mode">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </header>

  <div class="shell">
    {showSidebar && (
      <aside class="sidebar" id="sidebar">
        <h2>Lessons</h2>
        {lessons.map((n) => (
          <a class="topic-link" href={noteUrl(n.slug)} aria-current={n.slug === currentSlug ? 'page' : undefined}>
            <span class="day">{n.day ? String(n.day).padStart(2, '0') : '··'}</span>{n.title}
          </a>
        ))}
        <h2>Coming soon</h2>
        {stubs.map((n) => (
          <a class="topic-link stub" href={noteUrl(n.slug)} aria-current={n.slug === currentSlug ? 'page' : undefined}>
            <span class="day">··</span>{n.title}
          </a>
        ))}
      </aside>
    )}
    <slot />
    <div class="panels" id="panels" aria-live="polite"></div>
  </div>
  <div class="sheet-scrim" id="sheet-scrim" hidden></div>

  <script>
    import '../scripts/app';
  </script>
</body>
</html>
