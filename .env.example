# Where the knowledge repo lives (relative to this app, or absolute)
# KNOWLEDGE_PATH=../knoldgebase-storage   (optional; auto-detected)

# Ask box: off | local | cloud
PUBLIC_CHAT_MODE=off

# Local retriever (Python + SQLite + Ollama), used when PUBLIC_CHAT_MODE=local
PUBLIC_RETRIEVER_URL=http://localhost:8787

# Used by scripts/fetch-knowledge.mjs when KNOWLEDGE_PATH doesn't exist (Vercel)
KNOWLEDGE_REPO=https://github.com/Rpathuri-creator/knoldgebase-storage.git
KNOWLEDGE_BRANCH=main
